<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Privacy: this manifest requests no permissions, in particular no
         INTERNET, so typed text cannot leave the device. allowBackup is off
         so learned vocabulary is never copied into cloud backups. -->
    <application
        android:name=".KboardApp"
        android:allowBackup="false"
        android:label="@string/app_name" />
</manifest>
